# =====================================================================
# AgriAI Configuration & API Environment Variables (.env.example)
# Copy this file to .env and configure keys as needed.
# =====================================================================

# ---------------------------------------------------------------------
# 1. ONLINE SEARCH CONFIGURATION (Optional - Default: DuckDuckGo / Free)
# ---------------------------------------------------------------------
# By default, AgriAI uses DuckDuckGo (zero API key, zero subscription required).
# If you prefer Google search via SerpApi or Tavily AI search, provide keys below:
SEARCH_PROVIDER=duckduckgo
SERPAPI_API_KEY=
TAVILY_API_KEY=

# ---------------------------------------------------------------------
# 2. GENERATIVE AI ANSWER SUMMARIZATION (Optional - Default: Mode A Extractive)
# ---------------------------------------------------------------------
# By default, AgriAI uses Extractive Summarization (no LLM required, 100% free & local).
# If you want to enable Mode B (LLM-synthesized grounded answers), provide ONE key:
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_API_BASE=https://api.openai.com/v1/chat/completions

# ---------------------------------------------------------------------
# 3. WEATHER SERVICE CONFIGURATION (Optional - Default: Open-Meteo / Free)
# ---------------------------------------------------------------------
# By default, AgriAI uses the Open-Meteo Meteorological API (free, no key required).
# If using OpenWeatherMap instead:
WEATHER_API_KEY=

# ---------------------------------------------------------------------
# 4. MANDI MARKET PRICES (Default: Official Agmarknet Standard Integration)
# ---------------------------------------------------------------------
# Official portal: https://agmarknet.gov.in/
MARKET_API_KEY=

